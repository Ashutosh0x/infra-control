# Build output
/bin/
/dist/
*.exe
*.dll
*.so
*.dylib

# Test and coverage
*.test
*.out
coverage.*

# Local configuration and credentials
.infractl.yaml
.env
*.tfvars
!example.tfvars

# Terraform working files. The fixtures under testdata/ are committed
# deliberately and are matched by the negations below.
*.tfstate
*.tfstate.*
# Committed fixtures. testdata/ drives the tests; internal/cli/demodata is
# embedded into the binary for `infractl demo`, so a missing file here is a
# build failure rather than a test failure.
!testdata/*.tfstate
!internal/cli/demodata/*.tfstate
.terraform/
.terraform.lock.hcl
tfplan
plan.json
!testdata/plan.json
live.json
!testdata/live.json
!internal/cli/demodata/live.json

# Editor and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# GoReleaser build output
/dist/

# Drift history ledger. Committing it is the intended workflow (see
# docs/notifications.md), so it is deliberately NOT ignored. The temporary
# file the atomic write uses is.
.infractl/*.tmp
